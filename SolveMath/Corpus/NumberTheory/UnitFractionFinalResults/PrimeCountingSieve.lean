/-- Ported from `SolveMath.Corpus.Analysis.UnitFractionAnalyticMisc.Finset.Icc_sdiff_Icc_left`,
which is not in the kept-module set; restated locally since it is used below. -/
private lemma _root_.Finset.Icc_sdiff_Icc_left {x y z : ℕ} (h₁ : z ≤ y) (h₂ : x ≤ z) :
    Finset.Icc x y \ Finset.Icc x z = Finset.Ioc z y := by
  have h₁' := h₁
  have h₂' := h₂
  ext n
  simp [Finset.mem_sdiff]
  omega

